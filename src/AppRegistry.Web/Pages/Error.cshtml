@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="py-5 text-center">
    <h1 class="h3 mb-3">Something went wrong</h1>
    <p class="text-body-secondary mb-4">
        The page couldn't be loaded. Please try again. If it keeps happening, let the App Registry maintainer know.
    </p>
    <a asp-page="/Systems/Index" class="btn btn-primary">Back to Systems</a>
    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary mt-4 mb-0">Reference: <code>@Model.RequestId</code></p>
    }
</div>

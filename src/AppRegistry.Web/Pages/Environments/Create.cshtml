@page "{systemId:int}"
@model AppRegistry.Web.Pages.Environments.CreateModel
@{
    ViewData["Title"] = $"Add Environment – {Model.AppSystem.Name}";
}

<nav class="small mb-2"><a asp-page="/Systems/Details" asp-route-id="@Model.AppSystem.Id">← @Model.AppSystem.Name</a></nav>
<h1 class="h3 mb-3">Add Environment <span class="text-body-secondary fw-normal">to @Model.AppSystem.Name</span></h1>

<form method="post" class="col-lg-9">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_EnvironmentFields" for="AppEnvironment" />
    <button type="submit" class="btn btn-primary">Add Environment</button>
    <a asp-page="/Systems/Details" asp-route-id="@Model.AppSystem.Id" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

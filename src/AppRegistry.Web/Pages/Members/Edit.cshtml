@page "{id:int}"
@model AppRegistry.Web.Pages.Members.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Member.FullName}";
}

<nav class="small mb-2"><a asp-page="Details" asp-route-id="@Model.Member.Id">← Back to member</a></nav>
<h1 class="h3 mb-3">Edit Member</h1>

<form method="post" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_MemberFields" for="Member" />
    <div class="form-check form-switch mb-4">
        <input asp-for="Member.IsActive" class="form-check-input" role="switch" />
        <label asp-for="Member.IsActive" class="form-check-label">Active</label>
        <div class="form-text">Inactive members stay on their current systems but can't be picked for new ones.</div>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-page="Details" asp-route-id="@Model.Member.Id" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

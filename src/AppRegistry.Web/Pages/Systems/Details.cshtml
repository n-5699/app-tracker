@page "{id:int}"
@model AppRegistry.Web.Pages.Systems.DetailsModel
@{
    var s = Model.AppSystem;
    ViewData["Title"] = s.Name;
}

<nav class="small mb-2"><a asp-page="Index">← Systems</a></nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@s.Name</h1>
        @if (!string.IsNullOrWhiteSpace(s.Description))
        {
            <p class="text-muted mb-0" style="white-space: pre-line">@s.Description</p>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Edit" asp-route-id="@s.Id" class="btn btn-outline-secondary">Edit</a>
        <a asp-page="Delete" asp-route-id="@s.Id" class="btn btn-outline-danger">Delete</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small text-uppercase">Business Owner</div>
            <div class="fw-semibold">@s.BusinessOwner</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small text-uppercase">System Admin</div>
            <div class="fw-semibold">@(s.SystemAdmin ?? "—")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small text-uppercase">IT Developer</div>
            <div class="fw-semibold">@(s.ItDeveloper ?? "—")</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Environments <span class="text-body-secondary fw-normal">(@s.Environments.Count)</span></h2>
    <a asp-page="/Environments/Create" asp-route-systemId="@s.Id" class="btn btn-primary btn-sm">+ Add Environment</a>
</div>
@if (s.Environments.Count == 0)
{
    <div class="alert bg-body-tertiary border text-center py-4">
        <p class="mb-2">No environments recorded yet.</p>
        <a asp-page="/Environments/Create" asp-route-systemId="@s.Id" class="btn btn-outline-primary btn-sm">Add the first environment</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Type</th><th>Label</th><th>URL</th><th>Deployment Location</th><th>Notes</th><th></th></tr>
            </thead>
            @* One group per environment type, Production first. *@
            @foreach (var group in s.Environments.GroupBy(e => e.Type).OrderByDescending(g => g.Key))
            {
                <tbody>
                    @foreach (var env in group.OrderBy(e => e.Label))
                    {
                        <tr>
                            <td><span class="badge @env.Type.BadgeClass()">@env.Type</span></td>
                            <td>@env.Label</td>
                            <td class="text-break"><a href="@env.Url" target="_blank" rel="noopener">@env.Url</a></td>
                            <td>@env.DeploymentLocation</td>
                            <td class="small text-body-secondary">@env.Notes</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/Environments/Edit" asp-route-id="@env.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-page="/Environments/Delete" asp-route-id="@env.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}


<p class="text-muted small mt-4">
    Created @s.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ·
    Last updated @s.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
</p>

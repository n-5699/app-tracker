@page "{id:int}"
@model AppRegistry.Web.Pages.Systems.DetailsModel
@{
    var s = Model.AppSystem;
    ViewData["Title"] = s.Name;
}

<nav class="small mb-2"><a asp-page="Index">← Systems</a></nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@s.Name</h1>
        @if (!string.IsNullOrWhiteSpace(s.Description))
        {
            <p class="text-muted mb-0" style="white-space: pre-line">@s.Description</p>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Edit" asp-route-id="@s.Id" class="btn btn-outline-secondary">Edit</a>
        <a asp-page="Delete" asp-route-id="@s.Id" class="btn btn-outline-danger">Delete</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small text-uppercase">Business Owner</div>
            <div class="fw-semibold">@s.BusinessOwner</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small text-uppercase">System Admin</div>
            <div class="fw-semibold">@(s.SystemAdmin ?? "—")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small text-uppercase">IT Developer</div>
            <div class="fw-semibold">@(s.ItDeveloper ?? "—")</div>
        </div>
    </div>
</div>

<h2 class="h5">Environments</h2>
@if (s.Environments.Count == 0)
{
    <p class="text-muted">No environments recorded yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Type</th><th>Label</th><th>URL</th><th>Deployment Location</th><th>Notes</th></tr>
            </thead>
            <tbody>
                @foreach (var env in s.Environments.OrderBy(e => e.Type).ThenBy(e => e.Label))
                {
                    <tr>
                        <td><span class="badge text-bg-secondary">@env.Type</span></td>
                        <td>@env.Label</td>
                        <td><a href="@env.Url" target="_blank" rel="noopener">@env.Url</a></td>
                        <td>@env.DeploymentLocation</td>
                        <td class="small text-muted">@env.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p class="text-muted small mt-4">
    Created @s.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ·
    Last updated @s.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
</p>

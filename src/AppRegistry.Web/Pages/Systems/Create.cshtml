@page
@model AppRegistry.Web.Pages.Systems.CreateModel
@{
    ViewData["Title"] = "New System";
}

<nav class="small mb-2"><a asp-page="Index">← Systems</a></nav>
<h1 class="h3 mb-3">New System</h1>

<form method="post" class="col-lg-9">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_SystemFields" for="AppSystem" />
    <button type="submit" class="btn btn-primary">Create System</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

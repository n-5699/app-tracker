@* Shared form fields for Create and Edit, so both forms stay identical.
   The three people dropdowns are filled from the Members list (see LoadMemberOptionsAsync in the page models). *@
@model AppRegistry.Web.Models.AppSystem
@{
    var people = new[]
    {
        (Field: "BusinessOwnerId", Label: "Business Owner", Hint: "Who gives the requirements", Role: MemberRole.BusinessOwner, Required: true),
        (Field: "SystemAdminId", Label: "System Admin", Hint: "Who administers it", Role: MemberRole.SystemAdmin, Required: false),
        (Field: "ItDeveloperId", Label: "IT Developer", Hint: "Who maintains it", Role: MemberRole.ItDeveloper, Required: false),
    };
}

<div class="mb-3">
    <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Payroll Portal" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3" placeholder="What the system does and who uses it"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>
<div class="row g-3 mb-3">
    @foreach (var p in people)
    {
        var options = ViewData[$"{p.Field}Options"] as List<SelectListItem> ?? new();
        var id = Html.Id(p.Field);
        <div class="col-md-4">
            <label for="@id" class="form-label">@p.Label @if (p.Required) {<span class="text-danger">*</span>}</label>
            <select id="@id" name="@Html.Name(p.Field)" class="form-select"
                    data-val="@(p.Required ? "true" : null)" data-val-required="@(p.Required ? $"Choose a {p.Label}." : null)">
                <option value="">@(p.Required ? $"Select a {p.Label.ToLower()}…" : "— None —")</option>
                @foreach (var o in options)
                {
                    <option value="@o.Value" selected="@o.Selected">@o.Text</option>
                }
            </select>
            <div class="form-text">
                @p.Hint.
                @if (options.Count == 0)
                {
                    <span class="text-warning-emphasis">No @(p.Label.ToLower())s yet.</span>
                }
                <a asp-page="/Members/Create" asp-route-role="@p.Role" target="_blank">Add a member</a>
            </div>
            @Html.ValidationMessage(p.Field, null, new { @class = "text-danger small" })
        </div>
    }
</div>

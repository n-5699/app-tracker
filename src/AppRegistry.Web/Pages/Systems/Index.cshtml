@page
@model AppRegistry.Web.Pages.Systems.IndexModel
@{
    ViewData["Title"] = "Systems";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Systems</h1>
    <a asp-page="Create" class="btn btn-primary">+ New System</a>
</div>

@if (Model.Systems.Count == 0)
{
    <div class="alert bg-body-tertiary border text-center py-5">
        <p class="mb-2">No systems yet.</p>
        <a asp-page="Create" class="btn btn-outline-primary btn-sm">Add the first system</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Business Owner</th>
                    <th>System Admin</th>
                    <th>IT Developer</th>
                    <th class="text-end">Environments</th>
                    <th>Last Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Systems)
                {
                    <tr>
                        <td><a asp-page="Details" asp-route-id="@s.Id" class="fw-semibold">@s.Name</a></td>
                        <td>@s.BusinessOwner</td>
                        <td>@s.SystemAdmin</td>
                        <td>@s.ItDeveloper</td>
                        <td class="text-end">@s.Environments.Count</td>
                        <td class="text-muted small">@s.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@Model.Systems.Count system(s)</p>
}
